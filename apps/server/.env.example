# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
# Database
DATABASE_URL=mysql://cdn:cdn_pass_123@127.0.0.1:3306/cdn_panel
# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# JWT
JWT_SECRET=change_me_access_secret
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
# Encryption (AES-256-GCM, 32 bytes hex = 64 chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=5
# Node reporting stays disabled unless a random 32+ character secret is configured.
NODE_REPORT_TOKEN=
# Log
LOG_LEVEL=info
# M3 control-plane CNAME suffix. Use a DNS zone you control before real onboarding.
CNAME_SUFFIX=example.invalid
ACME_EMAIL=
ACME_ACCOUNT_KEY=
ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_ACCEPT_TOS=false
ACME_WORKER_ENABLED=false
ACME_DNS_PROVIDER=manual
ACME_CF_API_TOKEN=
ACME_CF_ZONE_ID=
VENDOR_WRITES_ENABLED=false
VENDOR_WRITE_WORKER_ENABLED=false
