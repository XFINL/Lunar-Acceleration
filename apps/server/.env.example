# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=mysql://cdn:cdn_pass_123@127.0.0.1:3306/cdn_panel

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change_me_access_secret
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (AES-256-GCM, 32 bytes hex = 64 chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100
LOGIN_THROTTLE_LIMIT=5

# Log
LOG_LEVEL=info

# M3 control-plane CNAME suffix. Use a DNS zone you control before real onboarding.
# example.invalid is intentionally non-resolving and is not production acceleration.
CNAME_SUFFIX=example.invalid

# ACME is opt-in. No CA calls are possible without an account key and explicit ToS acceptance.
# Use staging first; staging certificates are not trusted by browsers.
ACME_EMAIL=
ACME_ACCOUNT_KEY=
ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_ACCEPT_TOS=false
# Background workers/schedulers are owned by this application, not the chat session.
ACME_WORKER_ENABLED=false
# manual: display TXT records for the user. cloudflare: automatic DNS-01 with scoped credentials.
ACME_DNS_PROVIDER=manual
ACME_CF_API_TOKEN=
ACME_CF_ZONE_ID=

# M4 cloud writes are intentionally OFF by default. Review permissions and provider limits first.
# Registration/deletion jobs do NOT deploy cache/TLS or enable acceleration.
VENDOR_WRITES_ENABLED=false
VENDOR_WRITE_WORKER_ENABLED=false
