// Lunar-Acceleration 数据模型
// 对应设计文档 02-database.md（M1 范围：用户与权限、网站配置、系统配置、审计）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 3. 用户与权限模块
// ============================================================

/// 用户表
model User {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  username        String    @unique @db.VarChar(64)
  email           String?   @unique @db.VarChar(128)
  phone           String?   @db.VarChar(32)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  nickname        String?   @db.VarChar(64)
  avatar          String?   @db.VarChar(255)
  /// 0禁用 1正常 2待审核
  status          Int       @default(1) @db.TinyInt
  /// 1用户 2管理员 3超管
  roleType        Int       @default(1) @map("role_type") @db.TinyInt
  balance         Decimal   @default(0.00) @db.Decimal(12, 2)
  packageId       BigInt?   @map("package_id") @db.UnsignedBigInt
  packageExpireAt DateTime? @map("package_expire_at") @db.DateTime
  inviteCode      String?   @unique @map("invite_code") @db.VarChar(32)
  inviterId       BigInt?   @map("inviter_id") @db.UnsignedBigInt
  twoFaSecret     String?   @map("two_fa_secret") @db.VarChar(64)
  lastLoginAt     DateTime? @map("last_login_at") @db.DateTime
  lastLoginIp     String?   @map("last_login_ip") @db.VarChar(64)
  createdAt       DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  updatedAt       DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime
  deletedAt       DateTime? @map("deleted_at") @db.DateTime

  userRoles    UserRole[]
  apiKeys      UserApiKey[]
  loginLogs    UserLoginLog[]
  balances     UserBalance[]
  auditLogs    AuditLog[]
  userPackages UserPackage[]
  orders       Order[]
  payments     Payment[]
  transactions Transaction[]
  domains      Domain[]
  certificates Certificate[]
  trafficStatsHourly TrafficStatHourly[]
  accessLogs AccessLog[]
  logDeliveryConfigs LogDeliveryConfig[]
  trafficStatusHourly TrafficStatusHourly[]

  @@index([status])
  @@index([packageId])
  @@index([createdAt])
  @@map("users")
}

/// 角色表
model Role {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(64)
  code        String   @unique @db.VarChar(64)
  description String?  @db.VarChar(255)
  /// 1系统内置 0自定义
  isSystem    Int      @default(0) @map("is_system") @db.TinyInt
  createdAt   DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// 权限点表
model Permission {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(64)
  /// 如 domain:create
  code      String   @unique @db.VarChar(128)
  resource  String   @db.VarChar(64)
  action    String   @db.VarChar(32)
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime

  roles RolePermission[]

  @@index([resource])
  @@map("permissions")
}

/// 角色权限关联
model RolePermission {
  roleId       BigInt @map("role_id") @db.UnsignedBigInt
  permissionId BigInt @map("permission_id") @db.UnsignedBigInt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// 用户角色关联
model UserRole {
  userId BigInt @map("user_id") @db.UnsignedBigInt
  roleId BigInt @map("role_id") @db.UnsignedBigInt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// 用户 API 密钥
model UserApiKey {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt    @map("user_id") @db.UnsignedBigInt
  name       String    @db.VarChar(64)
  accessKey  String    @unique @map("access_key") @db.VarChar(64)
  /// Secret Key（加密存储）
  secretKey  String    @map("secret_key") @db.VarChar(128)
  /// 0禁用 1启用
  status     Int       @default(1) @db.TinyInt
  expireAt   DateTime? @map("expire_at") @db.DateTime
  lastUsedAt DateTime? @map("last_used_at") @db.DateTime
  createdAt  DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_api_keys")
}

/// 登录日志
model UserLoginLog {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt?  @map("user_id") @db.UnsignedBigInt
  username  String?  @db.VarChar(64)
  ip        String   @db.VarChar(64)
  region    String?  @db.VarChar(64)
  ua        String?  @db.VarChar(512)
  /// 1成功 0失败
  status    Int      @db.TinyInt
  message   String?  @db.VarChar(255)
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("user_login_logs")
}

/// 余额流水
model UserBalance {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt   @map("user_id") @db.UnsignedBigInt
  /// 1充值 2消费 3退款 4管理员调整
  type         Int      @db.TinyInt
  /// 变动金额，正负
  amount       Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal  @map("balance_after") @db.Decimal(12, 2)
  refType      String?  @map("ref_type") @db.VarChar(32)
  refId        BigInt?  @map("ref_id") @db.UnsignedBigInt
  remark       String?  @db.VarChar(255)
  operatorId   BigInt?  @map("operator_id") @db.UnsignedBigInt
  createdAt    DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("user_balances")
}

// ============================================================
// 4. 套餐与计费模块（M2）
// ============================================================

/// 套餐表
model Package {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name            String   @db.VarChar(64)
  code            String   @unique @db.VarChar(64)
  description     String?  @db.VarChar(512)
  /// 1自建节点 2第三方厂商 3混合
  accessType      Int      @map("access_type") @db.TinyInt
  vendorId        BigInt?  @map("vendor_id") @db.UnsignedBigInt
  /// 流量额度(字节)
  trafficQuota    BigInt   @default(0) @map("traffic_quota")
  /// 带宽上限(Kbps)
  bandwidthLimit  Int      @default(0) @map("bandwidth_limit")
  domainLimit     Int      @default(0) @map("domain_limit")
  requestQuota    BigInt   @default(0) @map("request_quota")
  /// 功能开关 WAF/实时日志/边缘脚本等
  featureFlags    Json?    @map("feature_flags")
  /// 1限速 2按量扣费 3停服
  overQuotaPolicy Int      @default(1) @map("over_quota_policy") @db.TinyInt
  price           Decimal  @default(0.00) @db.Decimal(10, 2)
  /// 1月 2季 3年
  period          Int      @default(1) @db.TinyInt
  /// 0下架 1上架
  status          Int      @default(1) @db.TinyInt
  sort            Int      @default(0)
  createdAt       DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  updatedAt       DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime

  userPackages UserPackage[]
  orders       Order[]

  @@index([status])
  @@index([vendorId])
  @@map("packages")
}

/// 用户套餐记录
model UserPackage {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt    @map("user_id") @db.UnsignedBigInt
  packageId      BigInt    @map("package_id") @db.UnsignedBigInt
  startAt        DateTime  @map("start_at") @db.DateTime
  expireAt       DateTime  @map("expire_at") @db.DateTime
  /// 已用流量(字节)
  trafficUsed    BigInt    @default(0) @map("traffic_used")
  /// 已用请求数
  requestUsed    BigInt    @default(0) @map("request_used")
  trafficResetAt DateTime? @map("traffic_reset_at") @db.DateTime
  /// Accrued allowance frozen at grant time; no longer follows mutable package values.
  trafficQuota   BigInt    @default(0) @map("traffic_quota")
  requestQuota   BigInt    @default(0) @map("request_quota")
  /// Latest paid order affecting this entitlement (used to safely unwind refunds).
  orderId        BigInt?   @unique @map("order_id") @db.UnsignedBigInt
  /// 1生效 2过期 3取消
  status         Int       @default(1) @db.TinyInt
  createdAt      DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([expireAt])
  @@map("user_packages")
}

/// 订单表
model Order {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  orderNo     String    @unique @map("order_no") @db.VarChar(64)
  userId      BigInt    @map("user_id") @db.UnsignedBigInt
  packageId   BigInt?   @map("package_id") @db.UnsignedBigInt
  /// 原价
  amount      Decimal   @db.Decimal(12, 2)
  discount    Decimal   @default(0.00) @db.Decimal(12, 2)
  /// 实付
  finalAmount Decimal   @map("final_amount") @db.Decimal(12, 2)
  /// Immutable package terms and exact entitlement rollback data captured at order creation/payment.
  packageSnapshot Json?  @map("package_snapshot")
  /// 1待支付 2已支付 3已取消 4已退款
  status      Int       @default(1) @db.TinyInt
  payChannel  String?   @map("pay_channel") @db.VarChar(32)
  payAt       DateTime? @map("pay_at") @db.DateTime
  createdAt   DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  updatedAt   DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  package  Package?    @relation(fields: [packageId], references: [id])
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

/// 订单明细
model OrderItem {
  id       BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  orderId  BigInt  @map("order_id") @db.UnsignedBigInt
  /// package/traffic_pack/bandwidth_pack
  itemType String  @map("item_type") @db.VarChar(32)
  itemId   BigInt  @map("item_id") @db.UnsignedBigInt
  name     String  @db.VarChar(128)
  price    Decimal @db.Decimal(12, 2)
  quantity Int     @default(1)
  subtotal Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

/// 支付记录（占位）
model Payment {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  orderId      BigInt   @map("order_id") @db.UnsignedBigInt
  userId       BigInt   @map("user_id") @db.UnsignedBigInt
  channel      String   @db.VarChar(32)
  /// 第三方交易号
  tradeNo      String?  @map("trade_no") @db.VarChar(128)
  amount       Decimal  @db.Decimal(12, 2)
  /// 1待支付 2成功 3失败 4已退款
  status       Int      @default(1) @db.TinyInt
  callbackData Json?    @map("callback_data")
  createdAt    DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  updatedAt    DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([tradeNo])
  @@map("payments")
}

/// 支付渠道配置（占位）
model PaymentChannel {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  channel   String   @unique @db.VarChar(32)
  name      String   @db.VarChar(64)
  /// 商户号/密钥等
  config    Json?
  /// 0禁用 1启用
  status    Int      @default(0) @db.TinyInt
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  updatedAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime

  @@map("payment_channels")
}

/// 资金流水
model Transaction {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt   @map("user_id") @db.UnsignedBigInt
  /// 1收入 2支出
  type         Int      @db.TinyInt
  amount       Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal  @map("balance_after") @db.Decimal(12, 2)
  refType      String?  @map("ref_type") @db.VarChar(32)
  refId        BigInt?  @map("ref_id") @db.UnsignedBigInt
  remark       String?  @db.VarChar(255)
  createdAt    DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("transactions")
}

// ============================================================
// 12. 网站配置模块
// ============================================================

/// 网站配置（KV 结构，按 group 分组）
model SiteConfig {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  groupKey    String   @map("group_key") @db.VarChar(64)
  configKey   String   @map("config_key") @db.VarChar(128)
  configValue Json?    @map("config_value")
  description String?  @db.VarChar(255)
  updatedAt   DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime

  @@unique([groupKey, configKey], name: "uk_group_key")
  @@index([groupKey])
  @@map("site_configs")
}

// ============================================================
// 13. 系统配置模块
// ============================================================

/// 系统配置
model SystemConfig {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  groupKey    String   @map("group_key") @db.VarChar(64)
  configKey   String   @map("config_key") @db.VarChar(128)
  configValue Json?    @map("config_value")
  description String?  @db.VarChar(255)
  updatedAt   DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime

  @@unique([groupKey, configKey], name: "uk_group_key")
  @@map("system_configs")
}

// ============================================================
// 15. 审计模块
// ============================================================

/// 操作审计
model AuditLog {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt?  @map("user_id") @db.UnsignedBigInt
  roleType   Int?     @map("role_type") @db.TinyInt
  module     String   @db.VarChar(64)
  action     String   @db.VarChar(64)
  targetType String?  @map("target_type") @db.VarChar(64)
  targetId   BigInt?  @map("target_id") @db.UnsignedBigInt
  before     Json?
  after      Json?
  ip         String?  @db.VarChar(64)
  ua         String?  @db.VarChar(512)
  createdAt  DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}


// ============================================================
// M3 域名、配置、缓存规则、源站与证书模型
// ============================================================

model Domain {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt    @map("user_id") @db.UnsignedBigInt
  domain       String    @unique @db.VarChar(253)
  cname        String    @db.VarChar(253)
  /// 1自建节点 2第三方厂商 3混合（从有效套餐继承）
  accessType   Int       @map("access_type") @db.TinyInt
  /// 1待审核 2部署中 3启用 4停用 5审核拒绝 6软删除
  status       Int       @default(1) @db.TinyInt
  /// 1待审核 2通过 3拒绝
  auditStatus  Int       @default(1) @map("audit_status") @db.TinyInt
  auditRemark  String?   @map("audit_remark") @db.VarChar(255)
  businessType String    @default("static") @map("business_type") @db.VarChar(32)
  tags         Json?
  remark       String?   @db.VarChar(255)
  createdAt    DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  updatedAt    DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime
  deletedAt    DateTime? @map("deleted_at") @db.DateTime

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  config       DomainConfig?
  cacheRules   CacheRule[]
  originGroups OriginGroup[]
  vendorResources VendorResource[]
  vendorWriteJobs VendorWriteJob[]
  trafficStatsHourly TrafficStatHourly[]
  accessLogs AccessLog[]
  logDeliveryConfig LogDeliveryConfig?
  trafficStatusHourly TrafficStatusHourly[]

  @@index([userId])
  @@index([status])
  @@index([auditStatus])
  @@index([createdAt])
  @@map("domains")
}

/// 已觀測到的逐小時流量快照；日統計由此表聚合。
model TrafficStatHourly {
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  domainId  BigInt   @map("domain_id") @db.UnsignedBigInt
  statTime  DateTime @map("stat_time") @db.DateTime(0)
  source    String   @db.VarChar(16)
  traffic   BigInt   @db.UnsignedBigInt
  requests Decimal @default(0) @db.Decimal(40, 0)
  bandwidthPeak Decimal @default(0) @map("bandwidth_peak") @db.Decimal(40, 0)
  cacheHit Decimal @default(0) @map("cache_hit") @db.Decimal(40, 0)
  cacheMiss Decimal @default(0) @map("cache_miss") @db.Decimal(40, 0)
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  statusCodes TrafficStatusHourly[]

  @@unique([domainId, source, statTime])
  @@index([userId, statTime])
  @@index([domainId, statTime])
  @@map("traffic_stats_hourly")
}


/// Per-hour status-code counters are stored separately for efficient reports.
model TrafficStatusHourly {
  userId BigInt @map("user_id") @db.UnsignedBigInt
  domainId BigInt @map("domain_id") @db.UnsignedBigInt
  statTime DateTime @map("stat_time") @db.DateTime(0)
  source String @db.VarChar(16)
  statusCode Int @map("status_code") @db.UnsignedSmallInt
  requests Decimal @default(0) @db.Decimal(40, 0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  hourly TrafficStatHourly @relation(fields: [domainId, source, statTime], references: [domainId, source, statTime], onDelete: Cascade)
  @@id([domainId, source, statTime, statusCode])
  @@index([userId, statTime, statusCode])
  @@map("traffic_status_hourly")
}

/// Raw access logs are retained for at most 30 days; every read checks expiresAt.
model AccessLog {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  userId BigInt @map("user_id") @db.UnsignedBigInt
  domainId BigInt @map("domain_id") @db.UnsignedBigInt
  eventTime DateTime @map("event_time") @db.DateTime(0)
  ip String @db.VarChar(45)
  url String @db.VarChar(2048)
  statusCode Int @map("status_code") @db.UnsignedSmallInt
  bytes BigInt @default(0) @db.UnsignedBigInt
  userAgent String? @map("user_agent") @db.VarChar(512)
  region String? @db.VarChar(96)
  isp String? @db.VarChar(96)
  source String @db.VarChar(16)
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  expiresAt DateTime @map("expires_at") @db.DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  @@index([domainId, eventTime, id])
  @@index([userId, eventTime, id])
  @@index([expiresAt])
  @@index([domainId, statusCode, eventTime])
  @@map("access_logs")
}

/// Safe presentation preferences only; webhook delivery is unsupported in this phase.
model LogDeliveryConfig {
  domainId BigInt @id @map("domain_id") @db.UnsignedBigInt
  userId BigInt @map("user_id") @db.UnsignedBigInt
  enabled Boolean @default(false)
  retentionDays Int @default(30) @map("retention_days") @db.UnsignedTinyInt
  updatedAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("log_delivery_configs")
}

model DomainConfig {
  domainId      BigInt   @id @map("domain_id") @db.UnsignedBigInt
  defaultTtl    Int      @default(3600) @map("default_ttl")
  originProtocol String  @default("http") @map("origin_protocol") @db.VarChar(16)
  originHost    String?  @map("origin_host") @db.VarChar(253)
  httpsEnabled  Boolean  @default(false) @map("https_enabled")
  certId        BigInt?  @map("cert_id") @db.UnsignedBigInt
  forceHttps    Boolean  @default(false) @map("force_https")
  hstsEnabled   Boolean  @default(false) @map("hsts_enabled")
  hstsMaxAge    Int      @default(31536000) @map("hsts_max_age")
  tlsVersion    String   @default("TLSv1.2") @map("tls_version") @db.VarChar(16)
  updatedAt     DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime

  domain      Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  certificate Certificate? @relation(fields: [certId], references: [id], onDelete: SetNull)

  @@index([certId])
  @@map("domain_configs")
}

model CacheRule {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  domainId      BigInt   @map("domain_id") @db.UnsignedBigInt
  name          String   @db.VarChar(64)
  priority      Int      @default(0)
  matchType     String   @default("path") @map("match_type") @db.VarChar(32)
  matchValue    String   @map("match_value") @db.VarChar(1024)
  matchMode     String   @default("exact") @map("match_mode") @db.VarChar(32)
  action        String   @default("cache") @db.VarChar(32)
  ttl           Int      @default(3600)
  ignoreParams  Boolean  @default(true) @map("ignore_params")
  cacheKey      String?  @map("cache_key") @db.VarChar(512)
  status        Int      @default(1) @db.TinyInt
  createdAt     DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime

  domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, priority])
  @@map("cache_rules")
}

model OriginGroup {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  domainId    BigInt   @map("domain_id") @db.UnsignedBigInt
  name        String   @db.VarChar(64)
  lbPolicy    String   @default("round_robin") @map("lb_policy") @db.VarChar(32)
  healthCheck Json?    @map("health_check")
  createdAt   DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime

  domain  Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  origins Origin[]

  @@index([domainId])
  @@map("origin_groups")
}

model Origin {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  originGroupId BigInt   @map("origin_group_id") @db.UnsignedBigInt
  address       String   @db.VarChar(253)
  port          Int      @default(80)
  weight        Int      @default(1)
  isBackup      Boolean  @default(false) @map("is_backup")
  protocol      String   @default("http") @db.VarChar(16)
  host          String?  @db.VarChar(253)
  status        Int      @default(1) @db.TinyInt
  createdAt     DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime

  group OriginGroup @relation(fields: [originGroupId], references: [id], onDelete: Cascade)

  @@index([originGroupId])
  @@map("origins")
}

model Certificate {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt   @map("user_id") @db.UnsignedBigInt
  name       String   @db.VarChar(128)
  certType   String   @default("manual") @map("cert_type") @db.VarChar(32)
  certPem    String   @map("cert_pem") @db.Text
  /// Private key must only be persisted encrypted by application code.
  keyPem     String   @map("key_pem") @db.Text
  issuer     String   @db.VarChar(512)
  notBefore  DateTime @map("not_before") @db.DateTime
  notAfter   DateTime @map("not_after") @db.DateTime
  autoRenew  Boolean  @default(false) @map("auto_renew")
  chainPem String? @map("chain_pem") @db.Text
  acmeDomains Json? @map("acme_domains")
  acmeDirectory String? @map("acme_directory") @db.VarChar(255)
  lastRenewedAt DateTime? @map("last_renewed_at") @db.DateTime
  renewalError String? @map("renewal_error") @db.VarChar(512)
  status     Int      @default(1) @db.TinyInt
  createdAt  DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  configs DomainConfig[]

  @@index([userId])
  @@index([status])
  @@map("certificates")
}

// ACME state survives restarts. No unencrypted private material may be persisted.
model CertificateJob {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  userId BigInt @map("user_id") @db.UnsignedBigInt
  domainId BigInt? @map("domain_id") @db.UnsignedBigInt
  certificateId BigInt? @map("certificate_id") @db.UnsignedBigInt
  status String @default("pending") @db.VarChar(32)
  domains Json
  challenge Json?
  orderData Json? @map("order_data")
  privateKey String? @map("private_key") @db.Text
  csr String? @db.Text
  error String? @db.VarChar(512)
  expiresAt DateTime? @map("expires_at") @db.DateTime
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  updatedAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime
  @@index([userId,status])
  @@index([certificateId])
  @@index([expiresAt])
  @@map("certificate_jobs")
}

// M4 第一批：厂商凭据管理与只读资源观察，不代表云端部署。
model Vendor {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(64)
  code        String   @unique @db.VarChar(32)
  driver      String   @db.VarChar(64)
  logo        String?  @db.VarChar(255)
  description String?  @db.VarChar(512)
  status      Int      @default(1) @db.TinyInt
  sort        Int      @default(0)
  createdAt   DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  updatedAt   DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime
  accounts    VendorAccount[]

  @@map("vendors")
}

model VendorAccount {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  vendorId           BigInt    @map("vendor_id") @db.UnsignedBigInt
  name               String    @db.VarChar(64)
  accessKey          String    @map("access_key") @db.Text
  secretKey          String    @map("secret_key") @db.Text
  config             Json?
  status             Int       @default(1) @db.TinyInt
  lastSyncAt         DateTime? @map("last_sync_at") @db.DateTime
  credentialVersion  Int       @default(1) @map("credential_version")
  operationToken     String?   @map("operation_token") @db.VarChar(36)
  operationExpiresAt DateTime? @map("operation_expires_at") @db.DateTime
  createdAt          DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  updatedAt          DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime
  vendor             Vendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  resources          VendorResource[]
  logs               VendorSyncLog[]
  writeJobs          VendorWriteJob[]

  @@unique([vendorId, name])
  @@index([vendorId])
  @@map("vendor_accounts")
}

model VendorResource {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  vendorAccountId BigInt    @map("vendor_account_id") @db.UnsignedBigInt
  domainId        BigInt    @map("domain_id") @db.UnsignedBigInt
  vendorDomainId  String?   @map("vendor_domain_id") @db.VarChar(128)
  vendorCertId    String?   @map("vendor_cert_id") @db.VarChar(128)
  managedByPanel  Boolean   @default(false) @map("managed_by_panel")
  resourceData    Json?     @map("resource_data")
  syncedAt        DateTime? @map("synced_at") @db.DateTime
  account         VendorAccount @relation(fields: [vendorAccountId], references: [id], onDelete: Cascade)
  domain          Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([vendorAccountId, domainId])
  @@index([domainId])
  @@index([vendorAccountId])
  @@map("vendor_resources")
}

model VendorSyncLog {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  vendorAccountId BigInt   @map("vendor_account_id") @db.UnsignedBigInt
  action          String   @db.VarChar(64)
  /// 1成功，2失败；仅记录脱敏说明。
  status          Int      @db.TinyInt
  message         String?  @db.Text
  createdAt       DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  account         VendorAccount @relation(fields: [vendorAccountId], references: [id], onDelete: Cascade)

  @@index([vendorAccountId])
  @@map("vendor_sync_logs")
}

/// Durable, opt-in cloud registration/deletion queue; never contains credentials.
model VendorWriteJob {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  vendorAccountId BigInt @map("vendor_account_id") @db.UnsignedBigInt
  domainId BigInt @map("domain_id") @db.UnsignedBigInt
  requestedBy BigInt @map("requested_by") @db.UnsignedBigInt
  action String @db.VarChar(16)
  status String @default("queued") @db.VarChar(24)
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(64)
  activeKey String? @unique @map("active_key") @db.VarChar(64)
  credentialVersion Int @map("credential_version")
  originSnapshot Json? @map("origin_snapshot")
  externalId String? @map("external_id") @db.VarChar(128)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("next_attempt_at") @db.DateTime
  leaseToken String? @map("lease_token") @db.VarChar(36)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.DateTime
  errorCode String? @map("error_code") @db.VarChar(64)
  message String? @db.VarChar(255)
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  updatedAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime
  account VendorAccount @relation(fields: [vendorAccountId], references: [id], onDelete: Restrict)
  domain Domain @relation(fields: [domainId], references: [id], onDelete: Restrict)
  @@index([status,nextAttemptAt])
  @@index([vendorAccountId,createdAt])
  @@index([domainId])
  @@map("vendor_write_jobs")
}

// M6 第一安全切片：节点管理、一次性令牌、HMAC 心跳与指标上报。
model NodeGroup {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name        String   @db.VarChar(64)
  description String?  @db.VarChar(255)
  region      String?  @db.VarChar(64)
  createdAt   DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  nodes       Node[]
  @@map("node_groups")
}

model Node {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name           String    @db.VarChar(64)
  ip             String    @db.VarChar(64)
  port           Int       @default(443) @db.UnsignedInt
  region         String?   @db.VarChar(64)
  isp            String?   @db.VarChar(64)
  nodeGroupId    BigInt?   @map("node_group_id") @db.UnsignedBigInt
  /// 1在线 2离线 3维护 4部署中
  status         Int       @default(2) @db.TinyInt
  weight         Int       @default(1) @db.UnsignedInt
  version        String?   @db.VarChar(32)
  cpuCores       Int?      @map("cpu_cores") @db.UnsignedInt
  memoryMb       Int?      @map("memory_mb") @db.UnsignedInt
  diskGb         Int?      @map("disk_gb") @db.UnsignedInt
  bandwidthMbps  Int?      @map("bandwidth_mbps") @db.UnsignedInt
  lastHeartbeat  DateTime? @map("last_heartbeat") @db.DateTime
  createdAt      DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  updatedAt      DateTime  @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime
  group          NodeGroup? @relation(fields: [nodeGroupId], references: [id], onDelete: SetNull)
  token          NodeToken?
  metrics        NodeMetric[]
  nonces         NodeRequestNonce[]
  @@index([status])
  @@index([region])
  @@index([nodeGroupId])
  @@map("nodes")
}

model NodeToken {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  nodeId    BigInt   @unique @map("node_id") @db.UnsignedBigInt
  /// SHA-256(raw token) hex; raw token material is never persisted.
  tokenHash String   @map("token_hash") @db.Char(64)
  status    Int      @default(1) @db.TinyInt
  expireAt  DateTime? @map("expire_at") @db.DateTime
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  updatedAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @updatedAt @map("updated_at") @db.DateTime
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  @@map("node_tokens")
}

model NodeMetric {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  nodeId       BigInt   @map("node_id") @db.UnsignedBigInt
  statTime     DateTime @map("stat_time") @db.DateTime
  cpuUsage     Decimal? @map("cpu_usage") @db.Decimal(5, 2)
  memUsage     Decimal? @map("mem_usage") @db.Decimal(5, 2)
  diskUsage    Decimal? @map("disk_usage") @db.Decimal(5, 2)
  bandwidthIn  BigInt?  @map("bandwidth_in") @db.UnsignedBigInt
  bandwidthOut BigInt?  @map("bandwidth_out") @db.UnsignedBigInt
  connections  Int?     @db.UnsignedInt
  qps          Int?     @db.UnsignedInt
  cacheHitRate Decimal? @map("cache_hit_rate") @db.Decimal(5, 2)
  node         Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  @@index([nodeId, statTime])
  @@map("node_metrics")
}

model NodeRequestNonce {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  nodeId    BigInt   @map("node_id") @db.UnsignedBigInt
  nonce     String   @db.VarChar(128)
  expiresAt DateTime @map("expires_at") @db.DateTime
  createdAt DateTime @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at") @db.DateTime
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  @@unique([nodeId, nonce])
  @@index([expiresAt])
  @@map("node_request_nonces")
}
